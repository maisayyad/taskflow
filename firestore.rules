rules_version = '2';

// TaskFlow Firestore Security Rules
// Default: deny everything. Access is granted explicitly below (SRS sections 4 and 11).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function textBetween(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOwnerOf(project) {
      return signedIn() && request.auth.uid == project.ownerId;
    }

    function isMemberOf(project) {
      return signedIn() && request.auth.uid in project.memberIds;
    }

    function validProject(p) {
      return textBetween(p.name, 3, 80)
        && textBetween(p.description, 0, 1000)
        && p.memberIds is list
        && p.memberIds.size() <= 100
        && p.memberIds.toSet().size() == p.memberIds.size()   // no duplicate members
        && p.ownerId in p.memberIds;                          // owner is always a member
    }

    function validTask(t, project) {
      return textBetween(t.title, 3, 120)
        && textBetween(t.description, 0, 1000)
        && t.status in ['todo', 'in_progress', 'done']
        && t.priority in ['low', 'medium', 'high']
        && (t.assigneeId == null
            || (t.assigneeId is string && t.assigneeId in project.memberIds))
        && (t.dueDate == null
            || (t.dueDate is string && t.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    // ---------- users/{uid} ----------
    // Profiles hold only displayName, email and createdAt (never passwords).
    // - get: any signed-in user (needed to show member names; UIDs are unguessable).
    // - list: only single-result lookups (limit 1), used for "add member by email";
    //   this prevents dumping the whole user directory.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 1;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'email', 'createdAt'])
        && textBetween(request.resource.data.displayName, 1, 60)
        && textBetween(request.resource.data.email, 3, 254)
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && textBetween(request.resource.data.displayName, 1, 60);

      allow delete: if false;
    }

    // ---------- projects/{projectId} ----------
    match /projects/{projectId} {
      // get also allowed when the document does not exist so the UI can show "not found"
      // instead of "access denied"; an existing project is only readable by its members.
      allow get: if signedIn() && (resource == null || isMemberOf(resource.data));
      allow list: if signedIn() && isMemberOf(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'description', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && validProject(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Only the owner may edit the project or change membership.
      allow update: if isOwnerOf(resource.data)
        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'description', 'ownerId', 'memberIds', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validProject(request.resource.data);

      allow delete: if isOwnerOf(resource.data);

      // ---------- projects/{projectId}/tasks/{taskId} ----------
      match /tasks/{taskId} {
        function parent() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data;
        }

        function exactTaskKeys(t) {
          return t.keys().hasOnly(['title', 'description', 'status', 'priority', 'assigneeId',
                                   'createdBy', 'dueDate', 'createdAt', 'updatedAt'])
              && t.keys().hasAll(['title', 'description', 'status', 'priority', 'assigneeId',
                                  'createdBy', 'dueDate', 'createdAt', 'updatedAt']);
        }

        // Task reads: project members only (a non-member / changed URL gets nothing).
        allow read: if signedIn() && isMemberOf(parent());

        // Task creates: members; creator identity must be the caller.
        allow create: if signedIn()
          && isMemberOf(parent())
          && exactTaskKeys(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && validTask(request.resource.data, parent())
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Task updates:
        //  - owner: any task
        //  - member: only tasks they created or that are assigned to them,
        //            and only the assignee may change the status.
        // createdBy / createdAt are immutable; the project linkage is the document path.
        allow update: if signedIn()
          && isMemberOf(parent())
          && exactTaskKeys(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && validTask(request.resource.data, parent())
          && (isOwnerOf(parent())
              || ((resource.data.createdBy == request.auth.uid
                   || resource.data.assigneeId == request.auth.uid)
                  && (request.resource.data.status == resource.data.status
                      || resource.data.assigneeId == request.auth.uid)));

        // Task deletes: owner, or the member who created the task.
        allow delete: if signedIn()
          && isMemberOf(parent())
          && (isOwnerOf(parent()) || resource.data.createdBy == request.auth.uid);
      }
    }
  }
}
