# Firebase PUBLIC web-app configuration (Firebase console > Project settings > Your apps > Web app).
# These values are not secrets, but keep them in env vars (not in source code).
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# NEVER put service-account keys anywhere in this repository.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
